{
  "name": "scriptorium-writer",
  "version": "1.5.0",
  "description": "Local-first desktop app for writing long-form fiction, styled like the warm pages of a book.",
  "main": "./out/main/index.js",
  "author": "Julia Shtal",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --host",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "npm run typecheck && vite build --config vite.web.config.ts",
    "build:web:dev": "cross-env NODE_ENV=development vite build --config vite.web.config.ts --mode development",
    "build:win": "npm run build && electron-builder --win",
    "sync:android": "npm run build:web && npx cap sync android",
    "sync:android:dev": "npm run build:web:dev && npx cap sync android",
    "open:android": "npx cap open android",
    "run:android": "npm run build:web && npx cap run android",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --ext .ts,.tsx --cache",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project node",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "gen:icon": "node scripts/gen-icon.mjs",
    "gen:art": "node scripts/gen-readme-art.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource/pt-sans": "^5.2.8",
    "@fontsource/pt-serif": "^5.2.8",
    "@tabler/icons-react": "^3.44.0",
    "@tiptap/extension-text-align": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "archiver": "^7.0.1",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^6.0.4",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser": "^3.2.7",
    "adm-zip": "^0.6.0",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "playwright": "^1.62.1",
    "prettier": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^7.3.6",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
