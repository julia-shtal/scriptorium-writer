# Template for android/keystore.properties — copy this file to `keystore.properties`
# (same directory) and fill in real values. This .example file is committed; the real
# `keystore.properties` and every `*.jks` / `*.keystore` are gitignored at the repo root.
#
# WHY THE KEYSTORE MUST NEVER BE COMMITTED, AND MUST BE BACKED UP:
# Android identifies an installed app by the pair (applicationId, signing key). This app is
# distributed by its author — sideloaded from GitHub Releases, not through Google Play — so
# there is no store holding a second key and no authority that can rotate this one. The key
# below IS the app's identity: it is what every device compares before accepting an upgrade.
# Losing it means no future build can ever upgrade an existing install of
# com.juliashtal.scriptoriumwriter — users would have to uninstall (losing app-private data)
# and reinstall a differently-signed app. Leaking it lets anyone publish an "update" that
# devices will happily accept. So: keep exactly one copy, off the repository, backed up
# somewhere durable (password manager / encrypted offline backup), together with the
# passwords below.
#
# The certificate's SHA-256 fingerprint is the public half of this key. Once the first release
# is cut it gets published in docs/android.md and committed to android/release-fingerprint.txt,
# so users can check what signed an APK they downloaded; `npm run verify:apk` prints the
# fingerprint of a built APK and, once that file exists, refuses an APK that does not match.
#
# Generate a keystore with (JDK's keytool, run from the repository root):
#   keytool -genkeypair -v -keystore android/scriptorium-release.jks \
#     -alias scriptorium-release -keyalg RSA -keysize 4096 -validity 10000
#
# If android/keystore.properties is absent, the build still configures and runs — release
# builds are simply left unsigned, with a warning in the Gradle log.

# Path to the keystore. Resolved relative to android/ (the Gradle root project);
# an absolute path is also accepted, and is the better choice once the keystore is
# stored outside the repository.
storeFile=scriptorium-release.jks

# Password protecting the keystore file itself.
storePassword=CHANGE_ME

# Alias of the key inside the keystore (the -alias passed to keytool).
keyAlias=scriptorium-release

# Password protecting that key. keytool defaults it to the store password.
keyPassword=CHANGE_ME
